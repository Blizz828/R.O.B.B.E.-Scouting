# Netlify Environment Variables Example
# 
# In Netlify dashboard:
# 1. Go to Site Settings → Build & Deploy → Environment
# 2. Add variables here
# 3. They'll be available during build time

# API endpoint for global storage
# Example: https://my-robbe-server.herokuapp.com/api
REACT_APP_API_URL=https://your-api-server.com/api

# Enable polling mode (set to "true" to force polling instead of SSE)
REACT_APP_USE_POLLING=false

# Polling interval in milliseconds
REACT_APP_POLL_INTERVAL=2000
